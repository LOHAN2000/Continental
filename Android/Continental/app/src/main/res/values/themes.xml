<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Continental" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/text_primary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surfaces and backgrounds -->
        <item name="android:colorBackground">#F7F8FA</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">@color/black</item>

        <item name="android:statusBarColor">#F7F8FA</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material Dialog Theme for clean white background -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="Theme.Continental" parent="Base.Theme.Continental" />
</resources>
